{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard
  "name": "baluch-martyrs-memorial",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Only the built public files are uploaded (never node_modules or docs)
    "directory": "./dist",
    "binding": "ASSETS",
    // /about -> about.html, /about.html -> /about
    "html_handling": "auto-trailing-slash",
    // Serve dist/404.html with a real 404 status for unknown URLs
    "not_found_handling": "404-page",
    // Only API requests run the Worker; everything else is served straight from assets
    "run_worker_first": ["/api/*"]
  }
}
