// Firestore Security Rules for Baluch Martyrs Memorial
// Deploy via Firebase Console (Firestore Database > Rules) or `firebase deploy --only firestore:rules`
//
// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: martyrs/{martyrId}
// Document ID: Auto-generated Firestore ID (or legacy ID)
// Read Access: Public (memorial gallery, statistics, search, REST cache sync, tombstone delta sync)
// Write Access: Authenticated Memorial Administrator only (isAdmin())
// Fields:
//   - fullName: string (required non-empty after trim on approved docs, max 200 chars; allowed '' or existing name on 'deleted' tombstones)
//   - status: string (required 'approved' on create, optional on legacy docs; 'approved' or 'deleted' on update)
//   - id: string (optional/legacy, max 200 chars)
//   - fatherName: string | null (optional, max 200 chars)
//   - birthDate: timestamp | string | null (optional, string max 64 chars)
//   - martyrdomDate: timestamp | string | null (optional, string max 64 chars)
//   - birthPlace: string | null (optional, max 250 chars)
//   - martyrdomPlace: string | null (optional, max 250 chars)
//   - organization: string | null (optional, max 200 chars)
//   - affiliation: string | null (optional, max 200 chars)
//   - rank: string | null (optional, max 200 chars)
//   - biography: string | null (optional, max 15000 chars; cleared to ''/null on 'deleted' tombstones)
//   - familyDetails: string | null (optional, max 3000 chars; cleared to ''/null on 'deleted' tombstones)
//   - photo: string | null (optional, max 1048576 chars; data URI, /media/... R2 path, /assets/photos/... path, https URL, or ''; cleared to ''/null on 'deleted' tombstones)
//   - photoPath: string | null (optional portable media path, max 512 chars; /media/..., /assets/photos/..., https://..., or '')
//   - photoHash: string | null (optional media content hash for R2 deduplication, max 128 chars)
//   - photoShard: string | null (optional Cloudflare R2 shard prefix, max 32 chars)
//   - photoRemoved: bool | null (optional, true when admin explicitly cleared photo)
//   - hasPhoto: bool | null (optional/legacy boolean flag)
//   - submitterName: string | null (optional on legacy/admin edits, max 200 chars; cleared to ''/null on 'deleted' tombstones)
//   - submitterEmail: string | null (optional on legacy/admin edits, max 254 chars; cleared to ''/null on 'deleted' tombstones)
//   - submitterRelation: string | null (optional, max 200 chars; cleared to ''/null on 'deleted' tombstones)
//   - submitterPhone: string | null (optional, max 60 chars; cleared to ''/null on 'deleted' tombstones)
//   - submittedAt: timestamp | string | null (optional, string max 64 chars)
//   - approvedAt: timestamp | string | null (optional, string max 64 chars)
//   - updatedAt: timestamp | string | null (optional, string max 64 chars)
//   - photoUpdatedAt: timestamp | string | null (optional, string max 64 chars)
//   - deletedAt: timestamp | string | null (optional soft-delete timestamp, string max 64 chars)
//   - migratedAt: timestamp | string | null (optional, string max 64 chars)
//   - addedAt: timestamp | string | null (optional/legacy, string max 64 chars)
//
// Collection: pendingMartyrs/{submissionId}
// Document ID: Auto-generated Firestore ID
// Read Access: Authenticated Memorial Administrator only (protects submitter PII)
// Create Access: Public visitors (validated 'pending' submissions) or Admin
// Update/Delete Access: Authenticated Memorial Administrator only (isAdmin())
// Fields:
//   - fullName: string (required, non-empty after trim, max 200 chars)
//   - submitterName: string (required on public create, non-empty, max 200 chars; optional/clearable by admin)
//   - submitterEmail: string (required valid email on public create, max 254 chars; optional/clearable by admin)
//   - status: string (required, must equal 'pending')
//   - submittedAt: timestamp (required == request.time if sent on public create; timestamp | string | null for admin/legacy)
//   - Optional fields: id, fatherName, birthDate, martyrdomDate, birthPlace, martyrdomPlace,
//     organization, affiliation, rank, biography, familyDetails, photo (max 1048576 chars),
//     photoPath (admin only), photoHash (admin only), photoShard (admin only),
//     photoRemoved, hasPhoto, submitterRelation, submitterPhone, updatedAt, photoUpdatedAt,
//     migratedAt, addedAt
//
// Collection: test/{docId}
// Read Access: Public (connectivity health check)
// Write Access: Denied (false)
//
// Collection: adminAuditLog/{logId}
// Create Access: Authenticated Memorial Administrator only (isAdmin())
// Read/Update/Delete Access: Denied (false, append-only audit log)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the request carries a valid Firebase Auth identity
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user is the memorial administrator.
    // Supports custom claim `admin == true` and the bootstrapped Firebase Auth
    // account `admin@baluchmartyrs.com` (without blocking on email_verified).
    function isAdmin() {
      return isAuthenticated() &&
             (
               ('admin' in request.auth.token && request.auth.token.admin == true) ||
               ('email' in request.auth.token && request.auth.token.email == 'admin@baluchmartyrs.com')
             );
    }

    // Validate required fields exist on the resulting document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only allowed keys
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate email format
    function isValidEmail(email) {
      return email is string &&
             email.size() <= 254 &&
             email.matches('^[^\\s@]+@[^\\s@.]+(\\.[^\\s@.]+)*\\.[^\\s@.]{2,}$');
    }

    // Validate optional string for public creates (must be string within maxLen if present)
    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate optional string for admin creates/updates and legacy docs
    // (allows omitted, null, empty string "", or string within maxLen)
    function isValidOptionalAdminString(data, field, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    // Validate optional date field (timestamp, ISO/YYYY-MM-DD string, empty string "", or null)
    function isValidOptionalDateField(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is timestamp ||
             (data[field] is string && data[field].size() <= 64);
    }

    // Validate optional timestamp/audit date field for admin/legacy docs
    function isValidOptionalTimestampOrString(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is timestamp ||
             (data[field] is string && data[field].size() <= 64);
    }

    // Validate optional boolean field
    function isValidOptionalBool(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is bool;
    }

    // Validate safe raster data URI, R2 /media/ path, static asset path, HTTPS URL, or empty string in O(1)
    function isSafePhotoPrefix(photo) {
      return photo == '' ||
             (photo.size() >= 17 && photo[0:16].lower() == 'data:image/jpeg;') ||
             (photo.size() >= 16 && photo[0:15].lower() == 'data:image/jpg;') ||
             (photo.size() >= 16 && photo[0:15].lower() == 'data:image/png;') ||
             (photo.size() >= 16 && photo[0:15].lower() == 'data:image/gif;') ||
             (photo.size() >= 17 && photo[0:16].lower() == 'data:image/webp;') ||
             (photo.size() >= 8 && photo[0:7] == '/media/') ||
             (photo.size() >= 16 && photo[0:15] == '/assets/photos/') ||
             (photo.size() >= 9 && photo[0:8].lower() == 'https://');
    }

    // Validate safe portable media path for Cloudflare R2 (/media/), static assets, HTTPS URL, or empty string in O(1)
    function isSafeMediaPath(path) {
      return path == '' ||
             (path.size() >= 8 && path[0:7] == '/media/') ||
             (path.size() >= 16 && path[0:15] == '/assets/photos/') ||
             (path.size() >= 9 && path[0:8].lower() == 'https://');
    }

    // Validate optional photoPath for admin creates/updates and legacy docs
    function isValidOptionalAdminPhotoPath(data) {
      return !('photoPath' in data) ||
             data.photoPath == null ||
             (data.photoPath is string &&
              data.photoPath.size() <= 512 &&
              isSafeMediaPath(data.photoPath));
    }

    // Check that an optional PII or heavy field is cleared (omitted, null, or empty string)
    function isClearedField(data, field) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field] == '');
    }

    // Validate photo on public submission (bounded to Firestore's 1 MiB document ceiling)
    function isValidPublicPhoto(data) {
      return !('photo' in data) ||
             (data.photo is string &&
              data.photo.size() <= 1048576 &&
              isSafePhotoPrefix(data.photo));
    }

    // Validate photo for admin creates/updates and legacy docs (bounded to Firestore's 1 MiB document ceiling)
    function isValidAdminPhoto(data) {
      return !('photo' in data) ||
             data.photo == null ||
             (data.photo is string && data.photo.size() <= 1048576);
    }

    // ===============================================================
    // Allowed Field Lists
    // ===============================================================

    function publicPendingAllowedFields() {
      return [
        'id',
        'fullName',
        'fatherName',
        'birthDate',
        'martyrdomDate',
        'birthPlace',
        'martyrdomPlace',
        'biography',
        'familyDetails',
        'organization',
        'affiliation',
        'rank',
        'photo',
        'submitterName',
        'submitterEmail',
        'submitterRelation',
        'submitterPhone',
        'status',
        'submittedAt'
      ];
    }

    function pendingAdminAllowedFields() {
      return [
        'id',
        'fullName',
        'fatherName',
        'birthDate',
        'martyrdomDate',
        'birthPlace',
        'martyrdomPlace',
        'biography',
        'familyDetails',
        'organization',
        'affiliation',
        'rank',
        'photo',
        'photoPath',
        'photoHash',
        'photoShard',
        'photoRemoved',
        'hasPhoto',
        'submitterName',
        'submitterEmail',
        'submitterRelation',
        'submitterPhone',
        'status',
        'submittedAt',
        'updatedAt',
        'photoUpdatedAt',
        'migratedAt',
        'addedAt'
      ];
    }

    function approvedAllowedFields() {
      return [
        'id',
        'fullName',
        'fatherName',
        'birthDate',
        'martyrdomDate',
        'birthPlace',
        'martyrdomPlace',
        'biography',
        'familyDetails',
        'organization',
        'affiliation',
        'rank',
        'photo',
        'photoPath',
        'photoHash',
        'photoShard',
        'photoRemoved',
        'hasPhoto',
        'submitterName',
        'submitterEmail',
        'submitterRelation',
        'submitterPhone',
        'status',
        'submittedAt',
        'approvedAt',
        'updatedAt',
        'photoUpdatedAt',
        'deletedAt',
        'migratedAt',
        'addedAt'
      ];
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    // Public pending submission core schema & required fields
    function hasValidMartyrData() {
      let data = request.resource.data;
      return hasOnlyAllowedFields(publicPendingAllowedFields()) &&
             hasRequiredFields(['fullName', 'submitterName', 'submitterEmail', 'status']) &&
             data.fullName is string &&
             data.fullName.trim().size() > 0 &&
             data.fullName.size() <= 200 &&
             data.submitterName is string &&
             data.submitterName.trim().size() > 0 &&
             data.submitterName.size() <= 200 &&
             isValidEmail(data.submitterEmail) &&
             (!('submittedAt' in data) ||
              (data.submittedAt is timestamp && data.submittedAt == request.time));
    }

    // Public pending submission field types & DoS size bounds
    function hasReasonableSizes() {
      let data = request.resource.data;
      return isValidOptionalString(data, 'id', 200) &&
             isValidOptionalString(data, 'fatherName', 200) &&
             isValidOptionalString(data, 'birthPlace', 250) &&
             isValidOptionalString(data, 'martyrdomPlace', 250) &&
             isValidOptionalString(data, 'organization', 200) &&
             isValidOptionalString(data, 'affiliation', 200) &&
             isValidOptionalString(data, 'rank', 200) &&
             isValidOptionalString(data, 'biography', 15000) &&
             isValidOptionalString(data, 'familyDetails', 3000) &&
             isValidOptionalString(data, 'submitterRelation', 200) &&
             isValidOptionalString(data, 'submitterPhone', 60) &&
             isValidOptionalDateField(data, 'birthDate') &&
             isValidOptionalDateField(data, 'martyrdomDate') &&
             isValidPublicPhoto(data);
    }

    // Shared field validation for admin create/update across pending and approved collections
    function hasValidAdminCommonMartyrFields(data) {
      return 'fullName' in data &&
             data.fullName is string &&
             data.fullName.trim().size() > 0 &&
             data.fullName.size() <= 200 &&
             isValidOptionalAdminString(data, 'id', 200) &&
             isValidOptionalAdminString(data, 'fatherName', 200) &&
             isValidOptionalAdminString(data, 'birthPlace', 250) &&
             isValidOptionalAdminString(data, 'martyrdomPlace', 250) &&
             isValidOptionalAdminString(data, 'organization', 200) &&
             isValidOptionalAdminString(data, 'affiliation', 200) &&
             isValidOptionalAdminString(data, 'rank', 200) &&
             isValidOptionalAdminString(data, 'biography', 15000) &&
             isValidOptionalAdminString(data, 'familyDetails', 3000) &&
             isValidOptionalAdminString(data, 'submitterName', 200) &&
             isValidOptionalAdminString(data, 'submitterEmail', 254) &&
             isValidOptionalAdminString(data, 'submitterRelation', 200) &&
             isValidOptionalAdminString(data, 'submitterPhone', 60) &&
             isValidOptionalDateField(data, 'birthDate') &&
             isValidOptionalDateField(data, 'martyrdomDate') &&
             isValidAdminPhoto(data) &&
             isValidOptionalAdminPhotoPath(data) &&
             isValidOptionalAdminString(data, 'photoHash', 128) &&
             isValidOptionalAdminString(data, 'photoShard', 32) &&
             isValidOptionalBool(data, 'photoRemoved') &&
             isValidOptionalBool(data, 'hasPhoto') &&
             isValidOptionalTimestampOrString(data, 'submittedAt') &&
             isValidOptionalTimestampOrString(data, 'updatedAt') &&
             isValidOptionalTimestampOrString(data, 'photoUpdatedAt') &&
             isValidOptionalTimestampOrString(data, 'deletedAt') &&
             isValidOptionalTimestampOrString(data, 'migratedAt') &&
             isValidOptionalTimestampOrString(data, 'addedAt');
    }

    // Admin validator for pendingMartyrs (used in both create and update)
    function isValidAdminPendingMartyr(data) {
      return 'status' in data &&
             data.status == 'pending' &&
             hasValidAdminCommonMartyrFields(data);
    }

    // Admin validator for approved martyrs (used in both create and update)
    function isValidAdminApprovedMartyr(data) {
      return (!('status' in data) || data.status == 'approved') &&
             isValidOptionalTimestampOrString(data, 'approvedAt') &&
             hasValidAdminCommonMartyrFields(data);
    }

    // Admin validator for soft-delete tombstones on martyrs/{martyrId}
    // Enforces status == 'deleted' and clears all PII and heavy fields so delta-sync reads stay safe
    function isValidAdminTombstoneMartyr(data) {
      return 'status' in data &&
             data.status == 'deleted' &&
             isValidOptionalTimestampOrString(data, 'deletedAt') &&
             isValidOptionalTimestampOrString(data, 'updatedAt') &&
             isValidOptionalAdminString(data, 'fullName', 200) &&
             isValidOptionalAdminString(data, 'id', 200) &&
             isValidOptionalAdminString(data, 'fatherName', 200) &&
             isValidOptionalAdminString(data, 'birthPlace', 250) &&
             isValidOptionalAdminString(data, 'martyrdomPlace', 250) &&
             isValidOptionalAdminString(data, 'organization', 200) &&
             isValidOptionalAdminString(data, 'affiliation', 200) &&
             isValidOptionalAdminString(data, 'rank', 200) &&
             isValidOptionalDateField(data, 'birthDate') &&
             isValidOptionalDateField(data, 'martyrdomDate') &&
             isValidOptionalAdminPhotoPath(data) &&
             isValidOptionalAdminString(data, 'photoHash', 128) &&
             isValidOptionalAdminString(data, 'photoShard', 32) &&
             isValidOptionalBool(data, 'photoRemoved') &&
             isValidOptionalBool(data, 'hasPhoto') &&
             isValidOptionalTimestampOrString(data, 'submittedAt') &&
             isValidOptionalTimestampOrString(data, 'approvedAt') &&
             isValidOptionalTimestampOrString(data, 'photoUpdatedAt') &&
             isValidOptionalTimestampOrString(data, 'migratedAt') &&
             isValidOptionalTimestampOrString(data, 'addedAt') &&
             isClearedField(data, 'biography') &&
             isClearedField(data, 'familyDetails') &&
             isClearedField(data, 'photo') &&
             isClearedField(data, 'submitterName') &&
             isClearedField(data, 'submitterEmail') &&
             isClearedField(data, 'submitterPhone') &&
             isClearedField(data, 'submitterRelation');
    }

    // Validator for admin audit log entries
    function isValidAuditLogEntry(data) {
      return data is map && data.keys().size() <= 50;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // APPROVED MARTYRS COLLECTION (Public Gallery Read, Admin Write)
    match /martyrs/{martyrId} {
      // Anyone can read approved martyrs and tombstones (public memorial gallery, REST sync, delta sync)
      allow read: if true;

      // Only authenticated admin can create approved martyr records
      allow create: if isAdmin() &&
                       hasOnlyAllowedFields(approvedAllowedFields()) &&
                       'status' in request.resource.data &&
                       request.resource.data.status == 'approved' &&
                       isValidAdminApprovedMartyr(request.resource.data);

      // Only authenticated admin can update approved martyr records
      // Supports normal edits (status stays 'approved'/omitted), soft-delete tombstones (status -> 'deleted'),
      // and restoring a tombstone back to 'approved'.
      // Uses affectedKeys() so partial updateDoc() calls on legacy documents remain clean.
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(approvedAllowedFields()) &&
                       (!('status' in resource.data) ||
                        (resource.data.status in ['approved', 'deleted'] && 'status' in request.resource.data)) &&
                       (isValidAdminApprovedMartyr(request.resource.data) ||
                        isValidAdminTombstoneMartyr(request.resource.data));

      // Only authenticated admin can delete approved martyr records
      allow delete: if isAdmin();
    }

    // PENDING MARTYRS COLLECTION (Public Submit, Admin Full Control)
    match /pendingMartyrs/{submissionId} {
      // Only authenticated admin can read pending submissions (contains submitter PII)
      allow read: if isAdmin();

      // Public visitors can submit new valid pending entries; admin can also create pending entries
      allow create: if (hasValidMartyrData() &&
                        hasReasonableSizes() &&
                        request.resource.data.status == 'pending') ||
                       (isAdmin() &&
                        hasOnlyAllowedFields(pendingAdminAllowedFields()) &&
                        isValidAdminPendingMartyr(request.resource.data));

      // Only authenticated admin can edit pending submissions while keeping status == 'pending'
      allow update: if isAdmin() &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(pendingAdminAllowedFields()) &&
                       isValidAdminPendingMartyr(request.resource.data);

      // Only authenticated admin can delete pending submissions (approve, reject, clear)
      allow delete: if isAdmin();
    }

    // TEST COLLECTION (Read-only connectivity test)
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ADMIN AUDIT LOG (Admin create-only)
    match /adminAuditLog/{logId} {
      allow create: if isAdmin() && isValidAuditLogEntry(request.resource.data);
      allow read, update, delete: if false;
    }

    // DEFAULT DENY for all other collections and subcollections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
